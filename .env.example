# Postgres connection string. Railway provides this as `postgresql://...`;
# the app converts it to the psycopg driver form automatically.
DATABASE_URL=postgresql://ats:ats@localhost:5432/ats_tracker

# Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Check https://ai.google.dev/gemini-api/docs/models for the current
# Gemini Flash-Lite model id.
LLM_MODEL=gemini-3.5-flash-lite

# Single-user login password.
APP_PASSWORD=change-me

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-too

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Rate limits (seconds).
FETCH_MIN_SECONDS_PER_DOMAIN=3
LLM_MIN_SECONDS_BETWEEN_CALLS=6

LOG_LEVEL=INFO
